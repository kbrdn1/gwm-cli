#!/usr/bin/env bash
# Speckit Project Configuration
# Sourced by .specify/scripts/bash/common.sh and read by Claude skills
# Format: bash-sourceable key=value (no spaces around =)

# -- Branch Naming --
# Pattern tokens: {number}, {slug}
# Examples: "feat/#{number}-{slug}" => feat/#42-user-auth
#           "{number}-{slug}" => 42-user-auth
SPECKIT_BRANCH_PATTERN="feat/#{number}-{slug}"
SPECKIT_BRANCH_PREFIX="feat/#"
SPECKIT_BRANCH_SEPARATOR="-"

# -- Branch validation regex (used by check_feature_branch) --
# Must match the full branch name. Supports | for alternates.
SPECKIT_BRANCH_REGEX="^[a-z]+/#[0-9]+-|^[0-9]{3}-"

# -- Spec Directory Naming --
# Pattern tokens: {number}, {slug}
# Examples: "{number}-{slug}" => 42-user-auth
#           "{slug}" => user-auth
SPECKIT_SPEC_PATTERN="{number}-{slug}"

# -- Number Format --
# 0 = no padding (42), 3 = zero-padded (042), 4 = zero-padded (0042)
SPECKIT_NUMBER_PADDING=0

# -- Paths (relative to repo root) --
SPECKIT_SPEC_DIR=".specify/specs"
SPECKIT_SCRIPTS_DIR=".specify/scripts/bash"
SPECKIT_TEMPLATES_DIR=".specify/templates"
SPECKIT_CONSTITUTION=".specify/memory/constitution.md"

# -- Numeric prefix extraction regex for find_feature_dir_by_prefix --
# Group 1 must capture the number
SPECKIT_PREFIX_REGEX_STANDARD="^([0-9]+)-"
SPECKIT_PREFIX_REGEX_PREFIXED="^[a-z]+/#([0-9]+)-"
