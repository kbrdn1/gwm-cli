[
  {
    "label": "gwm-cli: Bootstrap new worktree (post-creation)",
    "command": "bash",
    "args": [
      "-c",
      "cd \"$ZED_MAIN_GIT_WORKTREE\" && gwm bootstrap \"$ZED_WORKTREE_ROOT\""
    ],
    "hooks": ["create_worktree"],
    "reveal": "no_focus",
    "hide": "on_success",
    "allow_concurrent_runs": false,
    "use_new_terminal": false
  },
  {
    "label": "gwm-cli: Run TUI [RECOMMENDED]",
    "command": "cd $ZED_WORKTREE_ROOT && make tui",
    "use_new_terminal": true,
    "reveal": "always",
    "shell": {
      "with_arguments": {
        "program": "/bin/bash",
        "args": ["-c"]
      }
    },
    "allow_concurrent_runs": false,
    "hide": "never",
    "reveal_target": "dock"
  },
  {
